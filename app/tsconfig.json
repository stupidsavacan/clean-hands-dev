{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "lib": ["ES2022", "DOM"],
    "moduleResolution": "Bundler", "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "strict": true, "noEmit": true, "skipLibCheck": true, "esModuleInterop": true,
    "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src", "vite.config.ts"]
}
